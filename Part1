            table.remove(args, 1)
            
            if permittedPlayers[player] then
                if commandName == "stun" and commands.stun then
                    commands.stun(args, player)
                elseif commandName == "kill" and commands.kill then
                    commands.kill(args)
                end
            end
        end
    end)
end)

