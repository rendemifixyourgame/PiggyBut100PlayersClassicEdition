local function parseNumber(text)
    text = text:lower():gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    
    local directNum = tonumber(text)
    if directNum then return directNum end
    
    if numberWords[text] then
        return numberWords[text]
    end
    
    if text == "nil" then return 0 end
    
    local words = {}
    for word in text:gmatch("%S+") do
        table.insert(words, word)
    end
    
    local result = ""
    for i, word in ipairs(words) do
        local num = numberWords[word]
        if num and num < 100 then
            result = result .. tostring(num)
        elseif num and num >= 100 then
            if result ~= "" then
                local currentVal = tonumber(result) or 0
                result = tostring(currentVal * num)
            else
                result = tostring(num)
            end
        end
    end
    
    return tonumber(result) or 0
end

