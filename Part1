        for player, _ in pairs(permittedPlayers) do
            if player.Character then
                table.insert(exemptCharacters, player.Character)
            end
        end

        local function isExempt(model)
            for _, exemptChar in pairs(exemptCharacters) do
                if model == exemptChar then return true end
            end
            return false
        end

        local function stunModel(model)
            if model:IsA("Model") and model:FindFirstChild("Head") and not isExempt(model) and not model:FindFirstChild("Traitor") then
                ChapterEvent:FireServer("Stun", "Weapon", model.Head, false, duration)
            end
        end

        for _, model in pairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model:FindFirstChild("Head") then
                stunModel(model)
            end
        end
