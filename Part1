local function loadKeybind()
    local ok, result = pcall(function()
        if isfile(SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            return data.keybind or DEFAULT_KEYBIND
        end
        return DEFAULT_KEYBIND
    end)
    return ok and result or DEFAULT_KEYBIND
end

local function saveKeybind(key)
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode({keybind = key}))
    end)
end

